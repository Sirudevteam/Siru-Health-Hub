# =============================================================
# Siru HealthHub — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=fhir_db
POSTGRES_USER=fhir_user
POSTGRES_PASSWORD=fhir_pass

# ── Backend (FastAPI) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fhir_user:fhir_pass@postgres:5432/fhir_db
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=false
FHIR_BASE_URL=https://localhost/fhir
CORS_ORIGINS=["http://localhost:3000","https://localhost"]

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://localhost/fhir
