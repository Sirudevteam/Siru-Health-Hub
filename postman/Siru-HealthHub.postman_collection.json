            "url": {
              "raw": "{{base_url}}/fhir/Patient",
              "host": ["{{base_url}}"],
              "path": ["fhir", "Patient"]
            },
            "description": "Submit malformed (non-JSON) body — expect 400 or 422"
          },
          "event": [
