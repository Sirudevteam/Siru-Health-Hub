                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('OperationOutcome returned', () => {",
                  "  pm.expect(pm.response.json().resourceType).to.eql('OperationOutcome');",
