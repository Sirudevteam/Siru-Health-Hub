# ==============================================================================
# Siru HealthHub — Production Environment Configuration (.env.production)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on your production host:
#    cp .env.production.example .env
# 2. Generate a secure secret key:
#    openssl rand -hex 32
# 3. Replace all placeholder values marked with [CHANGE-ME]
# 4. Restrict file permissions:
#    chmod 600 .env
# ==============================================================================

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME=Siru HealthHub FHIR API
APP_VERSION=1.0.0
DEBUG=false

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_DB=fhir_db
POSTGRES_USER=fhir_admin
# [CHANGE-ME] Generate a strong password (minimum 24 alphanumeric characters)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_VERY_SECURE_POSTGRES_PASSWORD_99812

# Database connection URL for async SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://fhir_admin:CHANGE_ME_TO_A_VERY_SECURE_POSTGRES_PASSWORD_99812@postgres:5432/fhir_db

# ── Security & JWT Authentication ─────────────────────────────────────────────
# [CHANGE-ME] Cryptographically secure key: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_SECURE_64_CHAR_HEX_KEY_RUN_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis Session & Blacklist Cache ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS & Host Allowed Origins ───────────────────────────────────────────────
# Specify only your legitimate production domains (no wildcards)
CORS_ORIGINS=["https://healthhub.yourhospital.org","https://api.healthhub.yourhospital.org"]

# ── FHIR Server Specification ─────────────────────────────────────────────────
FHIR_BASE_URL=https://healthhub.yourhospital.org/fhir
FHIR_VERSION=4.0.1

# ── Frontend Public Endpoints ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://healthhub.yourhospital.org

